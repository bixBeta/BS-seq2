process.container = '/workdir/TREx_shared/projects/TREX_rna_1.sif'
singularity.enabled = true
singularity.autoMounts = true
singularity.runOptions = "-B /local -B /SSD"


process {
  withLabel:process_low {
    cpus   =    2
    memory =    14.GB

  }
  withLabel:process_medium {
    cpus   =    8
    memory =    32.GB

  }
  withLabel:process_high {
    cpus   =    20
    memory =    200.GB

  }
  withLabel:process_bismark {
    cpus    =   20
    memory  =   200.GB
    container   = "file:///SSD/fa286/DIGITAL_STORM/rrbs-14/RRBS.sif"



  }

  withLabel:process_dedup {
    cpus    =   20
    memory  =   100.GB
    container   = "file:///workdir/TREx_shared/projects/CHIP_ATAC_DEV.sif"



  }

  withLabel:process_mqc {

    container = "docker://multiqc/multiqc:latest"
  
  }

  withLabel:process_screen {

    container = "file:///workdir/TREx_shared/projects/TREX_SCREEN.sif"
    
  }  

}


workflow.onComplete = {
    // any workflow property can be used here
    println "Pipeline complete"
    println "Command line: $workflow.commandLine"
}

workflow.onError = {
    println "Error: something went wrong"
}
